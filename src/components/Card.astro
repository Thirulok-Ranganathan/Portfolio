---
// src/components/Card.astro
interface Props {
  title?: string;
  subtitle?: string;
  href?: string;
  class?: string;
}

const { title, subtitle, href, class: className = "" } = Astro.props;
const Element = href ? 'a' : 'div';
---

<Element href={href} class={`glass-card card-component ${className}`}>
  {title && (
    <div class="card-header">
      <h3 class="card-title">{title}</h3>
      {subtitle && <span class="card-subtitle">{subtitle}</span>}
    </div>
  )}
  <div class="card-content">
    <slot />
  </div>
</Element>

<style>
  .card-component {
    display: flex;
    flex-direction: column;
    padding: 24px;
    text-decoration: none;
    color: var(--color-text-primary);
    outline: none;
  }

  /* Support clickable cards */
  a.card-component {
    cursor: pointer;
  }

  a.card-component:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-glow);
  }

  .card-header {
    margin-bottom: 12px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card-subtitle {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .card-content {
    font-size: 0.95rem;
    color: var(--color-text-primary);
    line-height: 1.6;
    flex-grow: 1;
  }
</style>
