---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
---

<Layout title={`404 - Page Not Found | ${config.name}`}>
  <div class="container error-container fade-in">
    <div class="error-card glass-card">
      <span class="error-code font-mono">404</span>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-message">It looks like the link you followed is broken, or the page has been moved.</p>
      <a href="/" class="home-button glass-card">
        Return to Home <span class="arrow">→</span>
      </a>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 200px);
    padding-top: 120px;
  }

  .error-card {
    text-align: center;
    padding: 48px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 24px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .error-code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.05em;
    margin-bottom: 8px;
  }

  .error-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .error-message {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .home-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-button:hover {
    background-color: var(--color-border);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .home-button .arrow {
    transition: transform 0.2s;
  }

  .home-button:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .error-card {
      padding: 32px 24px;
    }
  }
</style>
