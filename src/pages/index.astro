---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Skills from '../components/Skills.astro';
import config from '../config.json';
import { getCollection } from 'astro:content';
import { getTagColor } from '../utils/colorHelper';

// Get the latest 2 blog posts
const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Define indices of showcase projects for the homepage (SecureCloud Custom Drive and iGen-app)
const homeProjectsIndices = [1, 2];

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const getSkillColorClass = (skillName: string) => {
  const nameLower = skillName.toLowerCase();
  if (nameLower.includes('python') || nameLower.includes('fastapi')) return 'emerald';
  if (nameLower.includes('javascript') || nameLower.includes('node')) return 'orange';
  if (nameLower.includes('ai') || nameLower.includes('agent')) return 'pink';
  if (nameLower.includes('cloud') || nameLower.includes('aws') || nameLower.includes('gcp')) return 'blue';
  if (nameLower.includes('devops') || nameLower.includes('terraform')) return 'purple';
  if (nameLower.includes('sql') || nameLower.includes('mongo')) return 'indigo';
  return 'default';
};
---

<Layout title={`${config.name} | Portfolio`} description={config.bio}>
  <div class="container fade-in">
    <!-- Hero Section -->
    <header class="hero-section">
      <div class="hero-avatar-container">
        <div class="avatar-image-wrapper">
          <img src={`${import.meta.env.BASE_URL}${config.avatar.replace(/^\//, '')}`} alt={config.name} class="hero-avatar" />
        </div>
        {config.status.show && (
          <div class={`status-badge ${config.status.type}`}>
            <span class="pulse-dot"></span>
            <span class="status-text">{config.status.text}</span>
          </div>
        )}
      </div>
      <div class="hero-text-container">
        <h1 class="hero-name">{config.name}</h1>
        <p class="hero-title">{config.title}</p>
        <p class="hero-bio">{config.bio}</p>
        
        <div class="hero-actions">
          <a href={`${import.meta.env.BASE_URL}Thirulok_Ranganathan_Resume.pdf`} download class="primary-button">
            <span>📄 Download Resume</span>
          </a>
          <div class="hero-socials">
            {Object.entries(config.socials).map(([platform, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="social-button glass-card">
                <span class="social-platform-name">{platform}</span>
                <span class="social-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Highlights Section -->
    <section class="highlights-section reveal">
      <div class="section-header">
        <span class="section-tagline font-mono">🌟 Profile</span>
        <h2 class="section-title">Highlights</h2>
      </div>
      <div class="highlights-grid">
        <Card title="Cloud Automation & IaC" subtitle="Terraform & CI/CD">
          <p>Provisioning resilient AWS and GCP cloud infrastructure using Terraform, Helm, and GitHub Actions (GHA). Automating complex CI/CD pipelines to deploy containerized microservices securely.</p>
        </Card>
        <Card title="AI & Agent Engineering" subtitle="RAG & Agent Orchestration">
          <p>Designing custom AI agents, sub-agents, and Retrieval-Augmented Generation (RAG) pipelines. Built cost-saving instance recommendation and automated EMR analysis solutions presented at internal AI hackathons.</p>
        </Card>
      </div>
    </section>

    <!-- Projects Section (Preview) -->
    <section id="projects" class="projects-section reveal">
      <div class="section-header-row">
        <div class="section-header">
          <span class="section-tagline font-mono">💻 Showcase</span>
          <h2 class="section-title">Projects</h2>
        </div>
        <a href={`${import.meta.env.BASE_URL}projects`} class="view-all-button desktop-only glass-card">
          View all projects <span class="arrow">→</span>
        </a>
      </div>
      
      <div class="projects-grid">
        {homeProjectsIndices.map((originalIndex, displayIndex) => {
          const project = config.projects[originalIndex];
          return (
            <a href="#" class="project-card glass-card" data-index={originalIndex} style={`--animation-delay: ${displayIndex * 0.1}s`}>
              <div class="project-card-header">
                <span class="project-icon">{project.icon}</span>
                <h3 class="project-card-title">{project.title}</h3>
              </div>
              <p class="project-card-description">{project.description}</p>
              <div class="project-tags">
                {project.tags.map(tag => (
                  <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
                ))}
              </div>
              <span class="project-link-label">Learn More <span class="arrow">→</span></span>
            </a>
          );
        })}
      </div>

      <a href={`${import.meta.env.BASE_URL}projects`} class="view-all-button mobile-only primary-button">
        View all projects <span class="arrow">→</span>
      </a>
    </section>

    <!-- Skills Section (Preview) -->
    <section class="skills-preview-section reveal">
      <div class="section-header-row">
        <div class="section-header">
          <span class="section-tagline font-mono">⚡ Specialties</span>
          <h2 class="section-title">Skills & Technologies</h2>
        </div>
        <a href={`${import.meta.env.BASE_URL}skills`} class="view-all-button desktop-only glass-card">
          View all skills <span class="arrow">→</span>
        </a>
      </div>
      
      <!-- Infinite Horizontal Skills Marquee -->
      <div class="skills-marquee-container">
        <div class="skills-marquee-track">
          {config.skills.map(skill => (
            <span class={`skill-pill ${getSkillColorClass(skill.name)}`}>
              <span class="skill-icon">{skill.icon}</span> {skill.name}
            </span>
          ))}
          {config.skills.map(skill => (
            <span class={`skill-pill ${getSkillColorClass(skill.name)}`}>
              <span class="skill-icon">{skill.icon}</span> {skill.name}
            </span>
          ))}
        </div>
      </div>

      <a href={`${import.meta.env.BASE_URL}skills`} class="view-all-button mobile-only primary-button">
        View all skills <span class="arrow">→</span>
      </a>
    </section>

    <!-- Articles Section (Preview) -->
    <section class="blog-preview-section reveal">
      <div class="section-header-row">
        <div class="section-header">
          <span class="section-tagline font-mono">✍️ Written Articles</span>
          <h2 class="section-title">Recent Writings</h2>
        </div>
        <a href={`${import.meta.env.BASE_URL}blog`} class="view-all-button desktop-only glass-card">
          View all posts <span class="arrow">→</span>
        </a>
      </div>

      <div class="articles-grid">
        {posts.map(post => (
          <a href={`${import.meta.env.BASE_URL}blog/${post.id}`} class="article-card glass-card">
            <div class="article-metadata">
              <span class="article-date">{formatDate(post.data.pubDate)}</span>
              <div class="article-tags">
                {post.data.tags.slice(0, 2).map(tag => (
                  <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
                ))}
              </div>
            </div>
            <h3 class="article-title">{post.data.title}</h3>
            <p class="article-description">{post.data.description}</p>
            <span class="article-link">Read article <span class="arrow">→</span></span>
          </a>
        ))}
      </div>

      <a href={`${import.meta.env.BASE_URL}blog`} class="view-all-button mobile-only primary-button">
        View all posts <span class="arrow">→</span>
      </a>
    </section>
  </div>
</Layout>

<!-- Interactive Project Modal Overlay -->
<div id="project-modal" class="modal-backdrop">
  <div class="modal-card glass-card">
    <button id="close-modal" class="close-modal-btn" aria-label="Close modal">✕</button>
    <div class="modal-content">
      <div class="modal-header">
        <span id="modal-icon" class="modal-icon"></span>
        <h2 id="modal-title" class="modal-title"></h2>
      </div>
      <p id="modal-description" class="modal-description"></p>
      
      <div class="modal-section">
        <h3>Technical Accomplishments</h3>
        <ul id="modal-bullets" class="modal-bullets"></ul>
      </div>
      
      <div class="modal-tags-container">
        <h3>Technologies Utilized</h3>
        <div id="modal-tags" class="project-tags"></div>
      </div>
      
      <div class="modal-footer">
        <a id="modal-link" href="#" target="_blank" class="primary-button-modal">
          Visit Code Repository ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import config from '../config.json';
  import { getTagColor } from '../utils/colorHelper';

  const projectDetails = [
    {
      bullets: [
        "Implemented a custom thread-safety lock mechanism to handle concurrent read/write operations without data corruption.",
        "Designed an automated TTL (Time-To-Live) eviction algorithm that runs periodically to free system memory of expired keys.",
        "Built high-throughput batch insert utilities supporting up to 50 keys in a single transaction with atomic rollbacks.",
        "Exposed a simple CLI interface for quick local testing and integration."
      ]
    },
    {
      bullets: [
        "Secures files using a dual-layer system: symmetric AES encryption for file contents, and asymmetric RSA encryption for the AES key.",
        "Applies audio steganography to hide the encrypted RSA key inside local audio files, saving the audio locally.",
        "Performs end-to-end decryption directly from cloud storage using the audio file to extract the key and reconstruct the plain file.",
        "Enables file uploads and downloads directly through the app using integrated API keys, with plans to add user login authentication."
      ]
    },
    {
      bullets: [
        "Built a native iOS image generation app using Swift and Apple's Xcode IDE.",
        "Integrated OpenAI's DALL-E API to generate custom images from user prompt inputs dynamically.",
        "Designed a mobile-first user interface with smooth transitions, custom image viewing, and sharing features.",
        "Optimized network requests and image loading states using Swift's asynchronous concurrency features."
      ]
    },
    {
      bullets: [
        "Developed a native macOS desktop ChatGPT client using Swift and Xcode.",
        "Integrated OpenAI's chat completion APIs to provide responsive, real-time AI conversation streams.",
        "Built native macOS keyboard shortcut bindings and window state controls for seamless desktop accessibility.",
        "Implemented local file-based session persistence to securely cache and load user chat histories."
      ]
    },
    {
      bullets: [
        "Built a native macOS desktop menu bar application using Swift and Apple's Xcode IDE.",
        "Integrates directly with the macOS system status bar for low-profile, real-time repository monitoring.",
        "Communicates with the GitHub REST API to query commit streams, issue status updates, and release flags.",
        "Implemented local polling timers to fetch and parse repository activities with visual status updates in the status menu."
      ]
    },
    {
      bullets: [
        "Developed a native Android chat application in Java using the Android SDK.",
        "Integrated Socket.io (Socket.io-client-java) for full-duplex real-time messaging and channel synchronization.",
        "Implemented local user presence tracking and dynamic status updates within chat rooms.",
        "Configured Android Gradle build settings and optimized UI layouts for responsive mobile messaging."
      ]
    }
  ];

  const initModals = () => {
    const cards = document.querySelectorAll('.projects-section .project-card');
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('close-modal');
    
    if (!modal || !closeBtn) return;

    cards.forEach(card => {
      // Avoid duplicate event listener binding if this runs multiple times
      const newCard = card.cloneNode(true) as HTMLAnchorElement;
      card.parentNode?.replaceChild(newCard, card);

      newCard.addEventListener('click', (e) => {
        e.preventDefault();
        const indexStr = newCard.getAttribute('data-index');
        if (indexStr === null) return;
        const index = parseInt(indexStr);
        const project = config.projects[index];
        const details = projectDetails[index];

        if (!project || !details) return;

        // Populate modal contents
        document.getElementById('modal-icon')!.innerText = project.icon;
        document.getElementById('modal-title')!.innerText = project.title;
        document.getElementById('modal-description')!.innerText = project.description;

        // Populate bullets list
        const bulletsUl = document.getElementById('modal-bullets')!;
        bulletsUl.innerHTML = '';
        details.bullets.forEach(bullet => {
          const li = document.createElement('li');
          li.innerText = bullet;
          bulletsUl.appendChild(li);
        });

        // Populate tech tags
        const tagsDiv = document.getElementById('modal-tags')!;
        tagsDiv.innerHTML = '';
        project.tags.forEach(tag => {
          const span = document.createElement('span');
          span.className = `tag ${getTagColor(tag)}`;
          span.innerText = tag;
          tagsDiv.appendChild(span);
        });

        // Populate links
        const modalLink = document.getElementById('modal-link') as HTMLAnchorElement;
        modalLink.href = project.link;
        modalLink.innerText = project.link_type === 'github' ? 'Visit Code Repository ↗' : 'Visit Live Website ↗';

        // Show modal
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
    
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  };

  // Run on page load
  initModals();

  // Re-run on Astro view transition swaps
  document.addEventListener('astro:after-swap', initModals);
</script>

<style>
  /* Hero Section Styling */
  .hero-section {
    display: flex;
    align-items: center;
    gap: 48px;
    margin-bottom: 80px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-avatar-container {
    position: relative;
    flex-shrink: 0;
  }

  /* Rotating tech rings behind avatar */
  .avatar-image-wrapper {
    width: 150px;
    height: 150px;
    border-radius: 40px; /* Modern squircle/rounded style */
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    transition: border-color 0.3s;
  }

  .avatar-image-wrapper:hover {
    border-color: var(--color-accent);
  }

  .hero-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(2.05); /* Zoom in to show the face more clearly */
    transform-origin: center 62%; /* Focus slightly higher to target the face */
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .avatar-image-wrapper:hover .hero-avatar {
    transform: scale(2.13) rotate(-2deg);
  }

  .status-badge {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 99px;
    box-shadow: var(--shadow-card);
    white-space: nowrap;
    transition: border-color 0.3s;
  }

  .status-badge:hover {
    border-color: var(--color-border-hover);
  }

  .status-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .hero-text-container {
    display: flex;
    flex-direction: column;
  }

  .hero-name {
    font-size: 2.8rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero-title {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-top: 4px;
    letter-spacing: -0.01em;
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-top: 16px;
    line-height: 1.6;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    background-color: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .primary-button:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(249, 115, 22, 0.25);
  }

  body.dark-theme .primary-button {
    color: #0f1013;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(251, 146, 60, 0.25);
  }

  body.dark-theme .primary-button:hover {
    box-shadow: 0 6px 16px rgba(251, 146, 60, 0.35);
  }

  .hero-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .social-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-button:hover {
    background-color: var(--color-border);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .social-platform-name {
    text-transform: capitalize;
  }

  .social-arrow {
    font-size: 0.75rem;
    opacity: 0.6;
    transition: transform 0.2s;
  }

  .social-button:hover .social-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  /* Highlights Section Styling */
  .highlights-section {
    margin: 80px 0;
  }

  .section-tagline {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .section-title {
    font-size: 2rem;
    margin-top: 4px;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }

  /* Projects Section Styling */
  .projects-section {
    margin: 80px 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 20px;
    text-decoration: none;
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUpProject 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--animation-delay);
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .project-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .project-icon {
    font-size: 1.5rem;
  }

  .project-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .project-card-description {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .project-tags {
    margin-bottom: 20px;
  }



  .project-link-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .project-link-label .arrow {
    transition: transform 0.2s;
  }

  .project-card:hover .project-link-label .arrow {
    transform: translate(2px, -2px);
  }

  /* Blog Preview Styling */
  .blog-preview-section {
    margin: 80px 0 40px 0;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
  }

  .view-all-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-button:hover {
    background-color: var(--color-border);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .view-all-button .arrow {
    transition: transform 0.2s;
  }

  .view-all-button:hover .arrow {
    transform: translateX(2px);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 20px;
    text-decoration: none;
    transition: border-color 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s;
  }

  .article-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .article-metadata {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .article-date {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .article-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 8px;
    color: var(--color-text-primary);
  }

  .article-description {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .article-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .article-link .arrow {
    transition: transform 0.2s;
  }

  .article-card:hover .article-link .arrow {
    transform: translateX(4px);
  }

  /* Cascading Project Entrance Animation */
  @keyframes fadeInUpProject {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop and Mobile Helper Classes */
  .desktop-only {
    display: flex !important;
  }
  
  .mobile-only {
    display: none !important;
  }

  /* Skills Infinite Marquee */
  .skills-marquee-container {
    overflow: hidden;
    width: 100%;
    position: relative;
    padding: 16px 0;
    margin-top: 32px;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .skills-marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scrollMarquee 25s linear infinite;
  }

  .skills-marquee-container:hover .skills-marquee-track {
    animation-play-state: paused;
  }

