---
// src/pages/skills.astro
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
---

<Layout title={`Skills & Expertise | ${config.name}`} description={`Technical skills, specialties, and certifications of ${config.name}.`}>
  <div class="container fade-in">
    <!-- Skills Header -->
    <header class="skills-page-header reveal">
      <span class="section-tagline font-mono">⚡ My tools</span>
      <h1 class="skills-page-title">Skills & Technologies</h1>
      <p class="skills-page-subtitle">A comprehensive breakdown of my engineering capabilities, cloud platforms, and automation workflows.</p>
    </header>

    <!-- Interactive Filter Tabs -->
    <div class="filter-container reveal">
      <button class="filter-btn active" data-filter="all">Show All</button>
      <button class="filter-btn" data-filter="languages">Languages</button>
      <button class="filter-btn" data-filter="frameworks">Frameworks</button>
      <button class="filter-btn" data-filter="cloud">Cloud Infra</button>
      <button class="filter-btn" data-filter="devops">DevOps</button>
      <button class="filter-btn" data-filter="ai_engineering">AI Engineering</button>
      <button class="filter-btn" data-filter="tools">Tools & DBs</button>
    </div>

    <!-- Skills Category Grid -->
    <div class="skills-categories-grid reveal">
      {Object.entries(config.skills_categories).map(([category, list]) => (
        <div class="category-card glass-card" data-category={category}>
          <h2 class="category-title">
            {category === 'languages' && '🗣️ Languages'}
            {category === 'frameworks' && '📦 Frameworks & Libraries'}
            {category === 'cloud' && '☁️ Cloud Infrastructure'}
            {category === 'devops' && '🐳 DevOps & Automation'}
            {category === 'ai_engineering' && '🤖 AI & Agent Engineering'}
            {category === 'tools' && '🛠️ Tools & Databases'}
          </h2>
          <div class="skills-pills-wrap">
            {list.map((skill) => (
              <span class={`skill-pill ${config.skills_colors?.[category] || 'default'}`}>{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications Section -->
    <section class="certifications-section">
      <div class="section-header">
        <span class="section-tagline font-mono">📜 Achievements</span>
        <h2 class="section-title">Certifications & Training</h2>
      </div>
      <div class="certifications-grid">
        {config.certifications.map((cert) => (
          <div class="cert-card glass-card">
            <div class="cert-icon-wrap">🎓</div>
            <span class="cert-name">{cert}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  const initFilters = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.category-card') as NodeListOf<HTMLElement>;

    filterBtns.forEach(btn => {
      // Avoid duplicate event listener binding if this runs multiple times
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        // Remove active class from all buttons
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        // Add active to current button
        newBtn.classList.add('active');

        const filterValue = newBtn.getAttribute('data-filter');

        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (filterValue === 'all' || cardCategory === filterValue) {
            card.style.display = 'flex';
            // Trigger browser reflow for entry transition
            card.offsetHeight; 
            card.style.opacity = '1';
            card.style.transform = 'translateY(0) scale(1)';
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(12px) scale(0.97)';
            // Hide after transition ends
            setTimeout(() => {
              // Double check filter value hasn't changed before hiding
              const activeBtn = document.querySelector('.filter-btn.active');
              const currentFilter = activeBtn?.getAttribute('data-filter');
              if (currentFilter !== 'all' && card.getAttribute('data-category') !== currentFilter) {
                card.style.display = 'none';
              }
            }, 300);
          }
        });
      });
    });
  };

  // Run on page load
  initFilters();

  // Re-run on Astro view transition swaps
  document.addEventListener('astro:after-swap', initFilters);
</script>

<style>
  .skills-page-header {
    margin-bottom: 48px;
    max-width: 650px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .section-tagline {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .skills-page-title {
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    margin-top: 4px;
    line-height: 1.15;
  }

  .skills-page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-top: 12px;
    line-height: 1.6;
  }

  /* Interactive Filters Styling */
  .filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.05s;
  }

  .filter-btn {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 8px 18px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filter-btn:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
  }

  body.dark-theme .filter-btn.active {
    color: #0f1013;
    box-shadow: 0 4px 12px rgba(251, 146, 60, 0.2);
  }

  /* Categories Grid */
  .skills-categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    margin-bottom: 80px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
  }

  .category-card {
    padding: 32px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .category-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: capitalize;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 12px;
  }

  .skills-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-pill {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 99px;
    transition: all 0.2s ease;
  }

  .skill-pill:hover {
    background-color: var(--color-bg-card);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }

  body.dark-theme .skill-pill:hover {
    box-shadow: 0 4px 12px rgba(156, 163, 175, 0.05);
  }

  /* Certifications Styling */
  .certifications-section {
    margin-bottom: 40px;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 2rem;
    margin-top: 4px;
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 16px;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .cert-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .cert-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-border);
    border-radius: 10px;
    font-size: 1.2rem;
  }

  .cert-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .skills-categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
